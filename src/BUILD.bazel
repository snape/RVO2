load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")

package(default_package_metadata = [
    "//:license",
    "//:package_info",
])

filegroup(
    name = "hdrs",
    srcs = [
        "Export.h",
        "Line.h",
        "RVO.h",
        "RVOSimulator.h",
        "Vector2.h",
    ],
)

#  Linux (all)
#   - -Wformat=2 — stronger than what -Wall enables; combined with your existing -Werror=format-security it's the correct pairing
#
#   macOS arm64
#   - -mbranch-protection=standard — PAC is enforced at the ABI level by the OS, so the compiler flag has less impact here than on Linux, but it's still the right posture with LLVM 20
#
#   Windows
#   - /sdl — SDL checks that are a proper superset of /GS; you could replace /GS with /sdl (which implies it)
#   - /guard:ehcont — EH continuation metadata, pairs with your existing /guard:cf
#   - /Qspectre — Spectre v1 mitigations; low overhead for a library
#
#   Linux linkopts — looks solid. -z relro, -z now, -z noexecstack, -z separate-code are all there.
#
#   macOS linkopts — macOS's linker applies PIE and dead-strip security defaults automatically, so the empty set is fine.
#
#   Priority order: linux_aarch64 -mbranch-protection=standard first (real CFI gap), then -Wformat=2 everywhere, then the Windows items.

cc_library(
    name = "RVO",
    srcs = [
        "Agent.cc",
        "Agent.h",
        "KdTree.cc",
        "KdTree.h",
        "Line.cc",
        "Obstacle.cc",
        "Obstacle.h",
        "RVOSimulator.cc",
        "Vector2.cc",
    ],
    hdrs = [":hdrs"],
    copts = select({
        "//conditions:linux_aarch64": [
            "-Wall",
            "-fno-common",
            "-fstack-clash-protection",
            "-fstack-protector-strong",
            "-fvisibility-inlines-hidden",
            "-fvisibility=hidden",
            "-mbranch-protection=standard",
            "-std=c++98",
            "-Werror=conversion",
            "-Werror=format-security",
        ],
        "@platforms//os:linux": [
            "-Wall",
            "-fcf-protection=full",
            "-fno-common",
            "-fstack-clash-protection",
            "-fstack-protector-strong",
            "-fvisibility-inlines-hidden",
            "-fvisibility=hidden",
            "-std=c++98",
            "-Werror=conversion",
            "-Werror=format-security",
        ],
        "@platforms//os:macos": [
            "-Wall",
            "-fno-common",
            "-fstack-protector-strong",
            "-fvisibility-inlines-hidden",
            "-fvisibility=hidden",
            "-std=c++98",
            "-Werror=conversion",
            "-Werror=format-security",
        ],
        "@platforms//os:windows": [
            "/guard:cf",
            "/guard:ehcont",
            "/Qspectre",
            "/sdl",
            "/W4",
        ],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,-Bsymbolic-functions",
            "-Wl,-z,defs",
            "-Wl,-z,noexecstack",
            "-Wl,-z,now",
            "-Wl,-z,relro",
            "-Wl,-z,separate-code",
        ],
        "//conditions:default": [],
    }),
    local_defines = select({
        "//conditions:linux_opt": ["_FORTIFY_SOURCE=3"],
        "//conditions:macos_opt": ["_FORTIFY_SOURCE=3"],
        "@platforms//os:windows": ["RVO_EXPORTS"],
        "//conditions:default": [],
    }),
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "include",
    srcs = [":hdrs"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "usr/include/RVO",
    visibility = ["//:__pkg__"],
)
